{
    "build": {
      "env": {
        "NODE_ENV": "production"
      }
    },
    "installCommand": "npm install --legacy-peer-deps",
    "rewrites": [
      { "source": "/(.*)", "destination": "/" }
    ],
    "functions": {
      "src/app/api/generate-recipe/route.ts": {
        "maxDuration": 60
      },
      "src/app/api/nutrition/route.ts": {
        "maxDuration": 30
      },
      "src/app/api/analyze-food/route.ts": {
        "maxDuration": 30
      }
    }
  }
  