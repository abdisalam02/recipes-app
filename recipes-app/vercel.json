{
    "build": {
      "env": {
        "NODE_ENV": "production"
      }
    },
    "installCommand": "npm install --legacy-peer-deps",
    "functions": {
      "src/app/api/generate-recipe/route.ts": {
        "maxDuration": 60
      },
      "src/app/api/nutrition/route.ts": {
        "maxDuration": 30
      },
      "src/app/api/analyze-food/route.ts": {
        "maxDuration": 30
      }
    },
    "crons": [
      {
        "path": "/api/keep-alive",
        "schedule": "*/10 * * * *"
      }
    ]
  }
  